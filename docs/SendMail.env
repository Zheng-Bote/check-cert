# Configuration for SendMail (compatible with the C++ version)
# Relative paths are resolved relative to this file.
SMTP_SERVER="smtp.example.com"
SMTP_PORT="587"
SMTP_USERNAME="user@example.com"
SMTP_PASSWORD="secret_password"
SMTP_FROM="sender@example.com"
# "true" enforces STARTTLS (port 587)
SMTP_STARTTLS="true"
# Directory to watch (= OUTPUT_DIR of CheckCert)
WATCH_DIR="out"

# --- optional ---
# Implicit SSL/TLS (default: true for port 465)
#SMTP_SSL="false"
SMTP_SUBJECT="Web Certificate-Check"
#SMTP_TIMEOUT_SECONDS="30"
# Scan interval, minimum file age, wait time after a failure
#POLL_SECONDS="2"
#STABLE_SECONDS="2"
#RETRY_SECONDS="300"
