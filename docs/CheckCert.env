# Configuration for CheckCert
# Relative paths are resolved relative to this file.

# List of websites (one per line: host, host:port or URL)
WEBSITES_FILE="websites.txt"
# Directory in which the .SendMail file is created (= WATCH_DIR of SendMail)
OUTPUT_DIR="../send_mail/data"
# Recipient; the file is named <MAIL_RECIPIENT>.SendMail
MAIL_RECIPIENT="zheng.bote+webcertificate@googlemail.com"
# Warning threshold in days
WARN_DAYS="5"
# Connection timeout per website in seconds
TIMEOUT_SECONDS="10"
# Number of parallel checks
WORKERS="8"
